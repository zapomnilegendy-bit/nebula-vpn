# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nebula_vpn
DB_USER=nebula
DB_PASSWORD=nebula_secret
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=nebula_redis
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_GRPC_PORT=9090

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Rate Limiting
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Apple IAP
APPLE_SHARED_SECRET=

# Google IAP
GOOGLE_SERVICE_ACCOUNT=
