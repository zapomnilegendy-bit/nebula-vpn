root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_size = 4

[*.{ts,tsx,js,jsx,json}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.kt]
indent_size = 4

[*.swift]
indent_size = 4

[*.rs]
indent_size = 4

[*.xaml]
indent_size = 4

[*.sql]
indent_size = 2

[Makefile]
indent_style = tab
